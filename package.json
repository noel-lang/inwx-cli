{
  "name": "inwx-cli",
  "version": "0.2.0",
  "description": "Schön designte CLI für INWX-Domains & -DNS über die DomRobot-API, im Stil von vercel dns.",
  "type": "module",
  "bin": {
    "inwx": "dist/bin/inwx.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "records/example.records.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/bin/inwx.js",
    "start": "node dist/bin/inwx.js",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js"
  },
  "keywords": [
    "inwx",
    "dns",
    "domrobot",
    "cli",
    "nameserver",
    "dns-records",
    "domains",
    "domain-registration"
  ],
  "author": "Noel Lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noel-lang/inwx-cli.git"
  },
  "homepage": "https://github.com/noel-lang/inwx-cli#readme",
  "bugs": {
    "url": "https://github.com/noel-lang/inwx-cli/issues"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "otpauth": "^9.3.4",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  }
}
